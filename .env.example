# StockSense AI Environment Variables

# ==================== BACKEND ====================
# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Data Source (Yahoo Finance)
YAHOO_FINANCE_TIMEOUT=30
CACHE_TTL_HOURS=24

# ML Configuration
RANDOM_SEED=42
TF_DETERMINISTIC_OPS=1

# Model Storage
MODEL_DIR=models/saved

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# ==================== FRONTEND ====================
# Next.js Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# Feature Flags
NEXT_PUBLIC_ENABLE_WEBSOCKET=false
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# ==================== DEPLOYMENT ====================
# Render/Backend
RENDER_SERVICE_NAME=stocksense-api
RENDER_API_URL=https://stocksense-api.onrender.com

# Vercel/Frontend
VERCEL_PROJECT_NAME=stocksense-ai
VERCEL_API_URL=https://stocksense-ai.vercel.app

# ==================== OPTIONAL ====================
# Alpha Vantage (alternative data source)
ALPHA_VANTAGE_API_KEY=your_key_here

# Monitoring (optional)
SENTRY_DSN=
DATADOG_API_KEY=

# Database (future use)
DATABASE_URL=postgresql://user:pass@localhost:5432/stocksense